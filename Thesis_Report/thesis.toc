\contentsline {paragraph}{\nonumberline The free consistency check had too little overlap to compute.}{60}{paragraph*.130}%
\contentsline {paragraph}{\nonumberline A direct human-human kappa was computed instead.}{60}{paragraph*.132}%
\contentsline {paragraph}{\nonumberline A fresh LLM-judging round confirmed the same pattern from a third, author-independent angle.}{60}{paragraph*.134}%
\contentsline {paragraph}{\nonumberline A stronger result: independent human confirmation of the production-independent coverage claim.}{61}{paragraph*.136}%
