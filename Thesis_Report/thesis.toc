\contentsline {paragraph}{\nonumberline Limitation: precision is a lower bound, not an exact figure.}{50}{paragraph*.138}%
\contentsline {paragraph}{\nonumberline A second, distinct bias: active-learning sampling skews which relevant companies get verified, not just how many.}{50}{paragraph*.140}%
\contentsline {paragraph}{\nonumberline A third bias, harder to quantify: the author personally breaks judge disagreements, then those decisions score the author's own system.}{51}{paragraph*.142}%
\contentsline {paragraph}{\nonumberline Future work: tightening this bound with more exhaustive LLM ranking.}{51}{paragraph*.144}%
