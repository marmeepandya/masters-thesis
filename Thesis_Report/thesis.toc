\contentsline {subsection}{\numberline {5.3.13}What the External Review Found}{64}{subsection.5.3.13}%
\contentsline {paragraph}{\nonumberline The free consistency check had too little overlap to compute.}{64}{paragraph*.204}%
\contentsline {paragraph}{\nonumberline A direct human-human kappa was computed instead.}{64}{paragraph*.206}%
\contentsline {paragraph}{\nonumberline A fresh LLM-judging round confirmed the same pattern from a third, author-independent angle.}{64}{paragraph*.208}%
\contentsline {paragraph}{\nonumberline A stronger result: independent human confirmation of the production-independent coverage claim.}{65}{paragraph*.210}%
