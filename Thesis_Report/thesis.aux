\@writefile{toc}{\contentsline {paragraph}{\nonumberline A second, distinct bias: active-learning sampling skews which relevant companies get verified, not just how many.}{50}{paragraph*.140}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\nonumberline A third bias, harder to quantify: the author personally breaks judge disagreements, then those decisions score the author's own system.}{50}{paragraph*.142}\protected@file@percent }
