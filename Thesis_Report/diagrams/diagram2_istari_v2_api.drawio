<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Istari v2 API (reference system)">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1080" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- OFFLINE (ISTARI SIDE) SWIMLANE -->
        <mxCell id="2" value="OFFLINE -- done once by Istari (we do not run this)" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="760" height="340" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Global Organization Index (GOI)&#xa;~20,000,000 companies -- real production scale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="2">
          <mxGeometry x="40" y="40" width="680" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4" value="ISTARI INTERNAL INFRASTRUCTURE (opaque -- no visibility or control)" style="swimlane;startSize=30;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;html=1;" vertex="1" parent="2">
          <mxGeometry x="40" y="140" width="680" height="170" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Proprietary embedding model&#xa;(architecture unknown to us)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="4">
          <mxGeometry x="40" y="40" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Large-scale ANN index&#xa;(~20,000,000 vectors)" style="shape=cylinder3;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;boundedLbl=1;" vertex="1" parent="4">
          <mxGeometry x="360" y="40" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="4" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="2" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SCALE CONTRAST CALLOUT -->
        <mxCell id="21" value="Contrast with Diagram 1: our local pipeline evaluates over 98,716 companies -- roughly 200x smaller than this ~20M corpus" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="40" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- ONLINE SWIMLANE -->
        <mxCell id="9" value="ONLINE -- per query, via the v2 API" style="swimlane;startSize=30;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="760" height="520" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Our query text&#xa;(e.g. &quot;software companies&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="9">
          <mxGeometry x="40" y="40" width="680" height="50" as="geometry" />
        </mxCell>
        <mxCell id="11" value="HTTPS request to Istari v2 API endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="9">
          <mxGeometry x="40" y="130" width="680" height="50" as="geometry" />
        </mxCell>
        <mxCell id="12" value="ISTARI INTERNAL (opaque): embeds query + searches their 20M-vector index" style="swimlane;startSize=30;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;html=1;" vertex="1" parent="9">
          <mxGeometry x="40" y="220" width="680" height="100" as="geometry" />
        </mxCell>
        <mxCell id="13" value="(same proprietary model + index as the offline stage above -- internals hidden from us)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="12">
          <mxGeometry x="40" y="35" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="14" value="API response: top-K results&#xa;(JSON: domain, score)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="9">
          <mxGeometry x="40" y="340" width="680" height="50" as="geometry" />
        </mxCell>
        <mxCell id="15" value="Used ONLY as an external reference / comparison point&#xa;-- NOT integrated into our own retrieval pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="9">
          <mxGeometry x="40" y="420" width="680" height="70" as="geometry" />
