.env
thesis/
thesis_broken_*/
__pycache__/
*.pyc
logs/rclone_sync_*.log

# Large reproducible caches -- regenerable from notebooks + dataset/, backed up
# separately to Google Drive rather than git (GitHub hard-rejects files >100MB
# anyway, and git is not a good fit for tens of GB of binary blobs).
*.npy
*.faiss
*.index
*.pt
*.pkl
result/**/*.json

# Raw dataset file exceeds GitHub's 100MB hard limit (120MB) -- the gzipped
# copy (dataset/goi_search_results.json.gz, ~19MB) is committed instead.
dataset/goi_search_results.json

# All GOI/Istari company data is proprietary and/or too large for git (the
# pdl_companies export alone is ~10GB) -- backed up to Google Drive instead,
# see Thesis_Report/thesis.tex's Code Availability chapter.
dataset/

# Multi-GB model checkpoints and a corrupted intermediate cache that should
# never have been committed -- backed up to Google Drive where needed.
*.safetensors
*.npy.corrupted_backup
result/44_build_scaled_corpus/combined_pool.parquet

.claude/
.agents/
__pycache__/
skills-lock.json
scratch_bucket_analysis.py
review-thesis.md
common-commands.md
